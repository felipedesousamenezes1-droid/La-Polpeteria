{
  "name": "la-pulpeteria",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de pedidos em tempo real para o restaurante La Pulpeteria (PWA + Node.js + SQLite + Socket.IO).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "vite build",
    "build": "vite build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"tests/*.test.js\"",
    "e2e": "node scripts/e2e-duas-abas.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
